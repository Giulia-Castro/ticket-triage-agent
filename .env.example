# Copy to .env and fill in. Never commit .env.

APP_ENV=local
LOG_LEVEL=INFO

# SQLite for local use; PostgreSQL in docker-compose / production.
DATABASE_URL=sqlite:///./triage.db
# DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/triage

# Comma-separated "label:key" pairs. Keys need 16+ characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=local-dev:replace-with-a-long-random-key

# "keyword" runs offline (no API key, no cost). "claude" uses the Claude API.
TRIAGE_AGENT=keyword
PROMPT_VERSION=v2

# Claude API (only when TRIAGE_AGENT=claude). Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# USD per million tokens, used for the cost-per-ticket metric. Check current pricing.
PRICE_INPUT_PER_MTOK=4.00
PRICE_OUTPUT_PER_MTOK=20.00
